<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="using:Cloudreve.Desktop"
    x:Class="Cloudreve.Desktop.SettingsWindow" x:ClassModifier="internal" Title="{d:DesktopText settings.title}" Width="700" Height="500" MinWidth="600" MinHeight="400"
    WindowStartupLocation="CenterScreen" Background="{DynamicResource Paper}" Foreground="{DynamicResource Ink}">
  <Window.Styles><StyleInclude Source="/Styles/DesktopControls.axaml" /></Window.Styles>
  <Grid ColumnDefinitions="200,*">
    <Border Background="{DynamicResource HeaderFill}" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,1,0"><StackPanel>
      <d:BrandMark Height="24" Margin="16,16,8,12" />
      <ListBox x:Name="Navigation" SelectedIndex="0" Background="Transparent" Margin="8,0">
        <ListBoxItem><StackPanel Orientation="Horizontal" Spacing="16"><PathIcon Data="{StaticResource DriveIcon}" Width="20" /><TextBlock Text="{d:DesktopText settings.drives}" /></StackPanel></ListBoxItem>
        <ListBoxItem><StackPanel Orientation="Horizontal" Spacing="16"><PathIcon Data="{StaticResource GearIcon}" Width="20" /><TextBlock Text="{d:DesktopText settings.general}" /></StackPanel></ListBoxItem>
        <ListBoxItem><StackPanel Orientation="Horizontal" Spacing="16"><PathIcon Data="{StaticResource InfoIcon}" Width="20" /><TextBlock Text="{d:DesktopText settings.about}" /></StackPanel></ListBoxItem>
      </ListBox></StackPanel></Border>
    <ScrollViewer x:Name="Scroll" Grid.Column="1" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="24,16,24,24" Spacing="16">
      <StackPanel x:Name="DrivePage" Spacing="16"><StackPanel x:Name="Cards" Spacing="16" /><Button x:Name="AddButton" /></StackPanel>
      <StackPanel x:Name="GeneralPage" Spacing="16" IsVisible="False" />
      <StackPanel x:Name="AboutPage" Spacing="12" IsVisible="False"><TextBlock Text="{d:DesktopText settings.about}" FontSize="24" /><StackPanel Orientation="Horizontal" Spacing="16"><Image Source="/Assets/cloudreve.png" Width="48" Height="48" /><StackPanel><TextBlock Text="Cloudreve Desktop" FontSize="20" /><TextBlock x:Name="VersionLabel" Classes="secondary" /></StackPanel></StackPanel></StackPanel>
      <TextBlock x:Name="ErrorMessage" IsVisible="False" TextWrapping="Wrap" />
    </StackPanel></ScrollViewer>
  </Grid>
</Window>
