<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="using:Cloudreve.Desktop"
        x:Class="Cloudreve.Desktop.IgnoreRulesWindow" x:ClassModifier="internal" Title="{d:Tr settings.ignorePatternsTitle}"
        Width="500" Height="380" MinWidth="380" MinHeight="320" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Paper}" Foreground="{DynamicResource Ink}">
  <Window.Styles><StyleInclude Source="/Styles/DesktopControls.axaml" /></Window.Styles>
  <Grid RowDefinitions="Auto,*,Auto">
    <Grid Margin="24,20,24,0" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10">
      <PathIcon Width="20" Height="20" Data="{StaticResource FilterIcon}" Foreground="{DynamicResource Muted}" />
      <TextBlock Grid.Column="1" Text="{d:Tr settings.ignorePatterns}" FontSize="20" FontWeight="SemiBold" />
      <TextBlock Grid.Column="2" x:Name="DriveName" Classes="secondary" TextAlignment="Right" VerticalAlignment="Center"
                 TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Text, RelativeSource={RelativeSource Self}}" />
    </Grid>

    <Grid Grid.Row="1" Margin="24,12,24,16" RowDefinitions="Auto,*,Auto">
      <TextBlock Text="{d:Tr settings.ignorePatternsDescription}" Classes="secondary" TextWrapping="Wrap" Margin="0,0,0,12" />
      <TextBox Grid.Row="1" x:Name="RulesEditor" Classes="filled" AcceptsReturn="True" TextWrapping="Wrap"
               ScrollViewer.VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Padding="12,10"
               FontFamily="Menlo, monospace" FontSize="14" PlaceholderText="{d:Tr settings.ignorePatternsPlaceholder}"
               AutomationProperties.Name="{d:Tr settings.ignorePatterns}" />
      <TextBlock Grid.Row="2" x:Name="SaveError" IsVisible="False" Foreground="{DynamicResource DangerInk}" Margin="0,8,0,0"
                 TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
    </Grid>

    <Border Grid.Row="2" Padding="24,12" Background="{DynamicResource SidebarFill}" BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button x:Name="CancelButton" Classes="tool subtle" Content="{d:Tr settings.cancel}" IsCancel="True" MinWidth="76" MinHeight="36" />
        <Button x:Name="SaveButton" Classes="primary" Content="{d:Tr settings.save}" MinWidth="76" MinHeight="36" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
