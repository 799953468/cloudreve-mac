<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="using:Cloudreve.Desktop"
    x:Class="Cloudreve.Desktop.ActivityWindow" x:ClassModifier="internal" Width="370" Height="530" Title="Cloudreve"
    WindowDecorations="None" ShowInTaskbar="False" CanResize="False" WindowStartupLocation="CenterScreen" Background="{DynamicResource Paper}" Foreground="{DynamicResource Ink}">
  <Window.Styles>
    <StyleInclude Source="/Styles/DesktopControls.axaml" />
    <Style Selector="TextBlock.activitySection">
      <Setter Property="FontSize" Value="12" /><Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Muted}" /><Setter Property="LineHeight" Value="20" />
      <Setter Property="Margin" Value="16,12,16,3" />
    </Style>
    <Style Selector="PathIcon.queueUpload">
      <Setter Property="Data" Value="M11 16V6.8L7.4 10.4 6 9l6-6 6 6-1.4 1.4L13 6.8V16z M4 16h2v3h12v-3h2v5H4z" />
    </Style>
    <Style Selector="PathIcon.queueDownload">
      <Setter Property="Data" Value="M11 3h2v9.2l3.6-3.6L18 10l-6 6-6-6 1.4-1.4 3.6 3.6z M4 16h2v3h12v-3h2v5H4z" />
    </Style>
    <Style Selector="PathIcon.queueCompare">
      <Setter Property="Data" Value="M3 7h13l-3-3 1.5-1.5L20 8l-5.5 5.5L13 12l3-3H3z M21 17H8l3 3-1.5 1.5L4 16l5.5-5.5L11 12l-3 3h13z" />
    </Style>
    <Style Selector="PathIcon.spinning">
      <Style.Animations>
        <Animation Duration="0:0:1.6" IterationCount="INFINITE">
          <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="-360" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="Window.motion PathIcon#StatusIcon">
      <Setter Property="Transitions">
        <Transitions><BrushTransition Property="Foreground" Duration="0:0:0.2" /></Transitions>
      </Setter>
    </Style>
    <Style Selector="TextBlock.scanFailure">
      <Setter Property="Foreground" Value="{DynamicResource DangerInk}" />
    </Style>
  </Window.Styles>
  <Border x:Name="Root" BorderBrush="{DynamicResource PopupOutline}" BorderThickness="1" RenderTransformOrigin="50%,0%">
    <Grid RowDefinitions="Auto,*,Auto">
      <Border Background="{DynamicResource HeaderFill}" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Divider}" Padding="16,12,16,8">
        <StackPanel Spacing="12"><Grid ColumnDefinitions="*,Auto"><d:BrandMark Height="28" /><Button x:Name="SettingsButton" Grid.Column="1" Classes="tool icon" Width="30" Height="30" ToolTip.Tip="{d:Tr settings.title}" AutomationProperties.Name="{d:Tr settings.title}"><PathIcon Width="18" Height="18" Data="{StaticResource GearIcon}" /></Button></Grid>
          <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"><StackPanel x:Name="Chips" Orientation="Horizontal" Spacing="4" /></ScrollViewer>
        </StackPanel>
      </Border>
      <Grid Grid.Row="1"><ScrollViewer x:Name="TaskScroll" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="Tasks">
          <StackPanel x:Name="ScanSection" Classes="reveal">
            <Grid ColumnDefinitions="*,56" Margin="16,8,16,0">
              <TextBlock Classes="activitySection" Margin="0" Text="{d:Tr popup.scanStatus}" />
              <ProgressBar x:Name="ScanProgress" Grid.Column="1" Classes="syncProgress" MinWidth="0" Width="56" Height="3" ClipToBounds="True" VerticalAlignment="Center" IsIndeterminate="True" />
            </Grid>
            <ItemsControl x:Name="ScanItems">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="d:ScanRow" x:CompileBindings="True">
                  <Grid ColumnDefinitions="32,*,Auto" ColumnSpacing="8" Margin="16,5">
                    <PathIcon Width="20" Height="20" Foreground="{DynamicResource Muted}" Data="{StaticResource FolderIcon}" />
                    <StackPanel Grid.Column="1" Spacing="1">
                      <TextBlock Text="{Binding Drive}" FontWeight="Medium" LineHeight="19" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Drive}" />
                      <TextBlock Text="{Binding PhaseText}" Classes="secondary" Classes.scanFailure="{Binding Failed}" FontSize="12" LineHeight="16" TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding CountText}" IsVisible="{Binding !Failed}" Classes="secondary" FontSize="12" VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <StackPanel x:Name="ConflictSection" Classes="reveal">
            <TextBlock x:Name="ConflictTitle" Classes="activitySection" />
            <StackPanel x:Name="ConflictRows" />
            <TextBlock x:Name="ConflictMore" Classes="secondary" FontSize="12" Margin="56,2,16,5" />
          </StackPanel>
          <StackPanel x:Name="ActiveSection" Classes="reveal">
            <TextBlock Classes="activitySection" Text="{d:Tr popup.syncing}" />
            <StackPanel x:Name="ActiveRows" />
          </StackPanel>
          <StackPanel x:Name="WaitingSection" Classes="reveal">
            <TextBlock x:Name="WaitingTitle" Classes="activitySection" />
            <ItemsControl x:Name="WaitingItems">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="d:WaitingRow" x:CompileBindings="True">
                  <Grid ColumnDefinitions="32,*,Auto" ColumnSpacing="8" Margin="16,5"
                        ToolTip.Tip="{Binding Description}" AutomationProperties.Name="{Binding Description}">
                    <Border Width="28" Height="28" CornerRadius="8" Background="{DynamicResource OptionSelectedFill}" VerticalAlignment="Center">
                      <PathIcon Classes.queueUpload="{Binding IsUpload}" Classes.queueDownload="{Binding IsDownload}"
                                Classes.queueCompare="{Binding IsComparison}" Width="15" Height="15" Foreground="{DynamicResource Primary}" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="1">
                      <TextBlock Text="{Binding FileName}" FontWeight="Medium" LineHeight="19" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Location}" Classes="secondary" FontSize="12" LineHeight="16" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding Operation}" Classes="secondary" FontSize="12" VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="WaitingMore" Classes="secondary" FontSize="12" Margin="56,2,16,5" />
          </StackPanel>
          <StackPanel x:Name="RecentSection" Classes="reveal">
            <TextBlock Classes="activitySection" Text="{d:Tr popup.recent}" />
            <StackPanel x:Name="RecentRows" />
          </StackPanel>
        </StackPanel>
        </ScrollViewer>
        <StackPanel x:Name="Empty" Classes="reveal" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="14">
          <Border Width="64" Height="64" CornerRadius="32" Background="{DynamicResource OptionSelectedFill}">
            <PathIcon Width="28" Height="28" Data="{StaticResource FolderOutline}" Foreground="{DynamicResource Primary}" />
          </Border>
          <TextBlock Classes="secondary" Text="{d:Tr popup.noActivity}" TextAlignment="Center" />
        </StackPanel>
      </Grid>
      <Border Grid.Row="2" Background="{DynamicResource HeaderFill}" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Divider}" Padding="16,10">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <PathIcon x:Name="StatusIcon" Classes="activityInk" Width="16" Height="16" />
          <TextBlock x:Name="Footer" FontSize="13" VerticalAlignment="Center" />
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>
