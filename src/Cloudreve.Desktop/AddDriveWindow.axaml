<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="using:Cloudreve.Desktop"
        x:Class="Cloudreve.Desktop.AddDriveWindow" x:ClassModifier="internal" Title="{d:DesktopText addDrive.title}" Width="470" Height="630"
        CanResize="False" WindowStartupLocation="CenterScreen" Background="{DynamicResource HeaderFill}" Foreground="{DynamicResource Ink}">
  <Window.Styles><StyleInclude Source="/Styles/DesktopControls.axaml" /></Window.Styles>
  <Grid>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="48,24" VerticalAlignment="Center" Spacing="8">
      <Image x:Name="Logo" Source="/Assets/cloudreve.png" Width="120" Height="120" Margin="0,0,0,24" />
      <TextBlock x:Name="Heading" TextAlignment="Center" FontSize="24" FontWeight="Medium" TextWrapping="Wrap" />
      <TextBlock x:Name="Hint" Classes="secondary" TextAlignment="Center" TextWrapping="Wrap" />
      <StackPanel x:Name="Form" Spacing="12" Margin="0,12,0,0">
        <TextBox x:Name="Endpoint" Classes="filled" Height="56" VerticalContentAlignment="Center" AutomationProperties.Name="{d:DesktopText addDrive.siteUrl}" />
        <StackPanel x:Name="MountFields" Spacing="8" IsVisible="False">
          <Label Content="{d:DesktopText addDrive.localDriveName}" Target="{Binding #MountName}" Padding="0" />
          <TextBox x:Name="MountName" Classes="filled" />
          <Label Content="{d:DesktopText addDrive.localPath}" Target="{Binding #LocalPath}" Padding="0" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4"><TextBox x:Name="LocalPath" Classes="filled" /><Button Grid.Column="1" x:Name="Browse" Classes="tool" Content="{d:DesktopText addDrive.browse}" /></Grid>
        </StackPanel>
        <Button x:Name="Next" Classes="primary" HorizontalAlignment="Stretch" Height="42" IsDefault="True" />
        <Button x:Name="Back" Classes="tool" HorizontalAlignment="Stretch" Height="42" />
      </StackPanel>
    </StackPanel></ScrollViewer>
    <Border x:Name="ErrorPanel" IsVisible="False" VerticalAlignment="Bottom" Background="{DynamicResource HeaderFill}" Padding="16,8">
      <TextBlock x:Name="ErrorText" TextWrapping="Wrap" />
    </Border>
  </Grid>
</Window>
