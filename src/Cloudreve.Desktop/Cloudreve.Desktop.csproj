<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TrayLibrary>$(BaseIntermediateOutputPath)tray/$(Configuration)/libCloudreveTray.dylib</TrayLibrary>
    <OutputType>WinExe</OutputType>
    <AssemblyName>CloudreveClient</AssemblyName>
    <Version>0.1.0</Version>
    <RootNamespace>Cloudreve.Desktop</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Features>runtime-async=on</Features>
    <TargetsWindows Condition="$(RuntimeIdentifier.StartsWith('win')) or ('$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Windows')))">true</TargetsWindows>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetsWindows)' == 'true'">
    <ApplicationIcon>Assets/Cloudreve.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(TrayLibrary)" Link="libCloudreveTray.dylib" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="$([MSBuild]::IsOSPlatform('OSX')) and '$(TargetsWindows)' != 'true'" />
    <AvaloniaResource Include="Assets/cloudreve.png" />
    <AvaloniaResource Include="Assets/Fonts/Roboto.ttf" />
    <EmbeddedResource Include="Assets/Locales/*.json" WithCulture="false" LogicalName="Cloudreve.Desktop.Locales.%(Filename).json" />
    <None Update="Assets/Fonts/OFL.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Assets/Cloudreve-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <InternalsVisibleTo Include="Cloudreve.Sync.Tests" />
    <PackageReference Include="Avalonia.Desktop" Version="12.2.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.2.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="11.0.0" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Shared with the Cloudreve.Sync tool; shown under Shared so they are not mistaken for files in Sync/. -->
    <Compile Include="../Cloudreve.Sync/LocalFile*.cs" LinkBase="Shared" />
    <Compile Include="../Cloudreve.Sync/FailureLog.cs" Link="Shared/FailureLog.cs" />
  </ItemGroup>
  <Target Name="BuildMacTray" BeforeTargets="PrepareForBuild" Inputs="Platform/Native/MacTray.m" Outputs="$(TrayLibrary)" Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <MakeDir Directories="$(BaseIntermediateOutputPath)tray/$(Configuration)" />
    <Exec Command="xcrun clang -dynamiclib -fobjc-arc -arch arm64 -arch x86_64 -mmacosx-version-min=11.0 -framework AppKit Platform/Native/MacTray.m -o &quot;$(TrayLibrary)&quot;" />
  </Target>
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('OSX')) and '$(Configuration)' == 'Debug' and '$(RuntimeIdentifier)' == '' and '$(MacBundle)' != 'true'">
    <DebugBundleRoot>$(MSBuildProjectDirectory)/bin/Debug/$(TargetFramework)/Cloudreve.app</DebugBundleRoot>
    <OutputPath>$(DebugBundleRoot)/Contents/MacOS/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <UseAppHost>true</UseAppHost>
  </PropertyGroup>
  <Target Name="PrepareMacDebugBundle" AfterTargets="Build" Condition="'$(DebugBundleRoot)' != ''">
    <Copy SourceFiles="Info.plist" DestinationFolder="$(DebugBundleRoot)/Contents" SkipUnchangedFiles="true" />
    <Copy SourceFiles="Assets/Cloudreve.icns" DestinationFolder="$(DebugBundleRoot)/Contents/Resources" SkipUnchangedFiles="true" />
    <Exec Command="/usr/bin/codesign --force --deep --sign - &quot;$(DebugBundleRoot)&quot;" />
    <Exec Command="/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister -f &quot;$(DebugBundleRoot)&quot;" />
  </Target>
  <PropertyGroup Condition="'$(MacBundle)' == 'true'">
    <BundleRoot>$(MSBuildThisFileDirectory)../../artifacts/$(RuntimeIdentifier)/Cloudreve.app</BundleRoot>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <Target Name="AssembleMacBundle" AfterTargets="Publish" Condition="'$(MacBundle)' == 'true'">
    <Error Condition="'$(RuntimeIdentifier)' != 'osx-arm64' and '$(RuntimeIdentifier)' != 'osx-x64'" Text="Specify -r osx-arm64 or -r osx-x64." />
    <!-- Recreate the bundle so obsolete components from previous builds are never signed or shipped. -->
    <RemoveDir Directories="$(BundleRoot)/Contents" />
    <Copy SourceFiles="@(ResolvedFileToPublish->'$(PublishDir)%(RelativePath)')" DestinationFiles="@(ResolvedFileToPublish->'$(BundleRoot)/Contents/MacOS/%(RelativePath)')" />
    <Copy SourceFiles="Info.plist" DestinationFolder="$(BundleRoot)/Contents" />
    <Copy SourceFiles="Assets/Cloudreve.icns" DestinationFolder="$(BundleRoot)/Contents/Resources" />
    <Exec Command="/usr/bin/codesign --force --deep --sign - &quot;$(BundleRoot)&quot;" />
    <Exec Command="/usr/bin/codesign --verify --deep --strict &quot;$(BundleRoot)&quot;" />
  </Target>
</Project>
