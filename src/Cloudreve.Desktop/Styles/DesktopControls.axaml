<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Mirrors ui/src/theme.ts and the Material action palette in cloudreve/desktop. -->
  <Styles.Resources>
    <ResourceDictionary>
      <StreamGeometry x:Key="GearIcon">M19.4 13a7 7 0 0 0 0-2l2.1-1.6-2-3.5-2.5 1a8 8 0 0 0-1.8-1L14.8 3h-4l-.4 2.9a8 8 0 0 0-1.8 1l-2.5-1-2 3.5L6.2 11a7 7 0 0 0 0 2l-2.1 1.6 2 3.5 2.5-1a8 8 0 0 0 1.8 1l.4 2.9h4l.4-2.9a8 8 0 0 0 1.8-1l2.5 1 2-3.5z M12.8 15.5a3.5 3.5 0 1 1 0-7 3.5 3.5 0 0 1 0 7z</StreamGeometry>
      <StreamGeometry x:Key="FolderIcon">M2 5H10L12 7H22V20H2Z</StreamGeometry>
      <StreamGeometry x:Key="FolderOutline">M2 5H10L12 7H22V20H2Z M4 7V18H20V9H11L9 7Z</StreamGeometry>
      <StreamGeometry x:Key="SiteIcon">M12 2a10 10 0 1 0 0 20a10 10 0 1 0 0-20 M4.2 11h3.9c.1-2.4.7-4.6 1.4-6.3A8 8 0 0 0 4.2 11 M10.1 11h3.8c-.2-3-1-5.4-1.9-6.8-.9 1.4-1.7 3.8-1.9 6.8 M16 11h3.8a8 8 0 0 0-5.3-6.3A18 18 0 0 1 16 11 M4.2 13a8 8 0 0 0 5.3 6.3A18 18 0 0 1 8.1 13z M10.1 13c.2 3 1 5.4 1.9 6.8.9-1.4 1.7-3.8 1.9-6.8z M16 13a18 18 0 0 1-1.5 6.3 8 8 0 0 0 5.3-6.3z</StreamGeometry>
      <StreamGeometry x:Key="TrashIcon">M8 3h8l1 2h4v2H3V5h4z M5 9h14l-1 12H6z M8 11v8h2v-8z M13 11v8h2v-8z</StreamGeometry>
      <StreamGeometry x:Key="FilterIcon">M2 5h20v2H2z M5 11h14v2H5z M9 17h6v2H9z</StreamGeometry>
      <StreamGeometry x:Key="DriveIcon">M4 4H20L23 15V20H1V15Z M5.5 6L3.5 14H20.5L18.5 6Z M3 16V18H21V16Z</StreamGeometry>
      <StreamGeometry x:Key="InfoIcon">M12 2A10 10 0 1 0 12 22A10 10 0 1 0 12 2 M12 4A8 8 0 1 1 12 20A8 8 0 1 1 12 4 M11 10H13V17H11Z M11 7H13V9H11Z</StreamGeometry>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="BrandInk">Black</SolidColorBrush>
          <SolidColorBrush x:Key="Paper">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="HeaderFill">#F5F5F5</SolidColorBrush>
          <SolidColorBrush x:Key="SidebarFill">#FAFAFA</SolidColorBrush>
          <SolidColorBrush x:Key="Ink">#DE000000</SolidColorBrush>
          <SolidColorBrush x:Key="Muted">#99000000</SolidColorBrush>
          <SolidColorBrush x:Key="Divider">#1F000000</SolidColorBrush>
          <SolidColorBrush x:Key="PopupOutline">#70000000</SolidColorBrush>
          <SolidColorBrush x:Key="Primary">#1976D2</SolidColorBrush>
          <SolidColorBrush x:Key="PrimaryHover">#1565C0</SolidColorBrush>
          <SolidColorBrush x:Key="ProgressTrack">#A7CAED</SolidColorBrush>
          <SolidColorBrush x:Key="DangerInk">#C62828</SolidColorBrush>
          <SolidColorBrush x:Key="DangerFill">#14D32F2F</SolidColorBrush>
          <SolidColorBrush x:Key="DangerHover">#29D32F2F</SolidColorBrush>
          <SolidColorBrush x:Key="OnPrimary">White</SolidColorBrush>
          <SolidColorBrush x:Key="HoverFill">#0A000000</SolidColorBrush>
          <SolidColorBrush x:Key="SelectedFill">#14000000</SolidColorBrush>
          <SolidColorBrush x:Key="PressedFill">#1F000000</SolidColorBrush>
          <SolidColorBrush x:Key="FieldFill">#0F000000</SolidColorBrush>
          <SolidColorBrush x:Key="FieldHover">#17000000</SolidColorBrush>
          <SolidColorBrush x:Key="OptionSelectedFill">#E5F0FB</SolidColorBrush>
          <SolidColorBrush x:Key="DisabledInk">#61000000</SolidColorBrush>
          <SolidColorBrush x:Key="DisabledFill">#1F000000</SolidColorBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="BrandInk">White</SolidColorBrush>
          <SolidColorBrush x:Key="Paper">#121212</SolidColorBrush>
          <SolidColorBrush x:Key="HeaderFill">#212121</SolidColorBrush>
          <SolidColorBrush x:Key="SidebarFill">#212121</SolidColorBrush>
          <SolidColorBrush x:Key="Ink">White</SolidColorBrush>
          <SolidColorBrush x:Key="Muted">#B3FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="Divider">#1FFFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="PopupOutline">#66FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="Primary">#90CAF9</SolidColorBrush>
          <SolidColorBrush x:Key="PrimaryHover">#42A5F5</SolidColorBrush>
          <SolidColorBrush x:Key="ProgressTrack">#395063</SolidColorBrush>
          <SolidColorBrush x:Key="DangerInk">#FF9B96</SolidColorBrush>
          <SolidColorBrush x:Key="DangerFill">#1FF28B82</SolidColorBrush>
          <SolidColorBrush x:Key="DangerHover">#33F28B82</SolidColorBrush>
          <SolidColorBrush x:Key="OnPrimary">#DE000000</SolidColorBrush>
          <SolidColorBrush x:Key="HoverFill">#14FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="SelectedFill">#29FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="PressedFill">#3DFFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="FieldFill">#17FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="FieldHover">#21FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="OptionSelectedFill">#233A50</SolidColorBrush>
          <SolidColorBrush x:Key="DisabledInk">#4DFFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="DisabledFill">#1FFFFFFF</SolidColorBrush>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Styles.Resources>

  <Style Selector="TextBlock.secondary">
    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
  </Style>
  <Style Selector="ProgressBar.syncProgress">
    <Setter Property="Foreground" Value="{DynamicResource Primary}" />
    <Setter Property="Background" Value="{DynamicResource ProgressTrack}" />
  </Style>
  <Style Selector="Separator.cardDivider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="-16,6,-16,6" />
    <Setter Property="Background" Value="{DynamicResource Divider}" />
  </Style>
  <Style Selector="Button.chip"><Setter Property="Padding" Value="9,2" /><Setter Property="CornerRadius" Value="16" /><Setter Property="MinHeight" Value="24" /><Setter Property="FontSize" Value="13" /><Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="{DynamicResource Divider}" /></Style>
  <Style Selector="Button.chip.selected"><Setter Property="Background" Value="{DynamicResource SelectedFill}" /></Style>
  <Style Selector="Button.chip.add"><Setter Property="Background" Value="{DynamicResource Primary}" /><Setter Property="Foreground" Value="{DynamicResource OnPrimary}" /></Style>
  <Style Selector="Border.card"><Setter Property="BorderThickness" Value="1" /><Setter Property="BorderBrush" Value="{DynamicResource Divider}" /><Setter Property="CornerRadius" Value="12" /><Setter Property="Padding" Value="16" /></Style>
  <Style Selector="Button.primary, Button.tool">
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.tool">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Primary}" />
    <Setter Property="Padding" Value="8,4" />
  </Style>
  <Style Selector="Button.icon">
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
    <Setter Property="Padding" Value="4" />
  </Style>
  <Style Selector="Button.tool.driveLink">
    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>
  <Style Selector="Button.tool.subtle, Button.tool.danger">
    <Setter Property="Padding" Value="12,4" />
    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
    <Setter Property="Background" Value="{DynamicResource HoverFill}" />
  </Style>
  <Style Selector="Button.tool.danger">
    <Setter Property="Foreground" Value="{DynamicResource DangerInk}" />
    <Setter Property="Background" Value="{DynamicResource DangerFill}" />
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource Primary}" />
    <Setter Property="Foreground" Value="{DynamicResource OnPrimary}" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PrimaryHover}" />
    <Setter Property="Foreground" Value="{DynamicResource OnPrimary}" />
  </Style>
  <Style Selector="Button.tool:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverFill}" />
    <Setter Property="Foreground" Value="{TemplateBinding Foreground}" />
  </Style>
  <Style Selector="Button.tool:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PressedFill}" />
    <Setter Property="Foreground" Value="{TemplateBinding Foreground}" />
  </Style>
  <Style Selector="Button.tool.subtle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SelectedFill}" />
  </Style>
  <Style Selector="Button.tool.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.tool.danger:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource DangerHover}" />
  </Style>
  <Style Selector="Button:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource Primary}" />
  </Style>
  <Style Selector="Button.primary:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource OnPrimary}" />
  </Style>
  <Style Selector="Button.tool:disabled /template/ ContentPresenter#PART_ContentPresenter, Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource DisabledInk}" />
  </Style>
  <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource DisabledFill}" />
  </Style>

  <Style Selector="TextBox.filled">
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="PlaceholderForeground" Value="{DynamicResource Muted}" />
    <Setter Property="Background" Value="{DynamicResource FieldFill}" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="CaretBrush" Value="{DynamicResource Primary}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="FontSize" Value="16" />
  </Style>
  <Style Selector="TextBox.filled:not(:disabled) /template/ TextBlock#PART_Placeholder">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="TextBox.filled:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource FieldHover}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="TextBox.filled:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource FieldFill}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Primary}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="ComboBox.preference">
    <Setter Property="MinWidth" Value="132" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Padding" Value="12,5,0,5" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="{DynamicResource FieldFill}" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Divider}" />
    <Setter Property="BorderThickness" Value="1" />
    <Style Selector="^:pointerover:not(:disabled) /template/ Border#Background">
      <Setter Property="Background" Value="{DynamicResource FieldHover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PopupOutline}" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#HighlightBackground, ^[IsDropDownOpen=True] /template/ Border#Background">
      <Setter Property="BorderBrush" Value="{DynamicResource Primary}" />
      <Setter Property="Background" Value="{DynamicResource FieldFill}" />
    </Style>
    <Style Selector="^[IsDropDownOpen=True] /template/ PathIcon#DropDownGlyph">
      <Setter Property="Foreground" Value="{DynamicResource Primary}" />
      <Setter Property="RenderTransform" Value="rotate(180deg)" />
    </Style>
    <Style Selector="^ /template/ Popup#PART_Popup">
      <Setter Property="VerticalOffset" Value="4" />
    </Style>
    <Style Selector="^ /template/ Border#PopupBorder">
      <Setter Property="Background" Value="{DynamicResource Paper}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PopupOutline}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="4" />
    </Style>
    <Style Selector="^ ComboBoxItem">
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Style Selector="^:pointerover:not(:disabled) /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FieldHover}" />
      </Style>
      <Style Selector="^:selected:not(:disabled) /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource OptionSelectedFill}" />
        <Setter Property="Foreground" Value="{DynamicResource Primary}" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>
    </Style>
  </Style>

  <Style Selector="ListBox#Navigation ListBoxItem">
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Margin" Value="0,0,0,4" />
    <Setter Property="Padding" Value="16,8" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
  </Style>
  <Style Selector="ListBox#Navigation PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
  </Style>
  <Style Selector="ListBox#Navigation ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverFill}" />
  </Style>
  <Style Selector="ListBox#Navigation ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SelectedFill}" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
  </Style>
  <Style Selector="ListBox#Navigation ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBox#Navigation ListBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PressedFill}" />
  </Style>
</Styles>
